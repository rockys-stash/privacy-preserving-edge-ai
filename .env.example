# Copy to .env and edit. `make serve` exports these; nothing else reads .env. Never commit .env.
# The benchmark itself needs no credentials and no API keys.

# Bind address and port for `edgebench serve`. A non-loopback host requires EDGEBENCH_API_TOKEN.
EDGEBENCH_HOST=127.0.0.1
EDGEBENCH_PORT=8000

# Bearer token. When set, every /api route except /api/health needs it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EDGEBENCH_API_TOKEN=

# Requests per second per client before the API answers 429.
EDGEBENCH_RATE_PER_SEC=30
